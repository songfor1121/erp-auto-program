# AI Extractor (Google Gemini)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Control Flags
# Set to 'False' in production to use actual Gemini Multimodal OCR
USE_MOCK_OCR="True"

# Database Configuration
# Default is SQLite for MVP/Local testing. Use PostgreSQL for Production
DATABASE_URL="sqlite:///./invoice_app.db"

# Server Configuration
PORT="8000"
CORS_ORIGINS="http://localhost:3000"
